# setup.env.example — copy to setup.env and replace every CHANGEME.
# scripts/agent-run.sh sources this file; AGENTS.md documents each step.
#
#   cp setup.env.example setup.env
#   scripts/agent-run.sh --dry-run    # print every command, run nothing
#   scripts/agent-run.sh              # run all steps; grep 'STEP .* OK'

# ---- nodes (CHANGEME) ----
HEAD_HOST=CHANGEME          # ssh hostname of the head node (Ray head + API)
WORK_HOST=CHANGEME          # ssh hostname of the worker node
HEAD_IP=CHANGEME            # head IP on the point-to-point link
HEAD_IF=CHANGEME            # head netdev carrying that IP (see ibdev2netdev)
WORK_IP=CHANGEME            # worker IP on the point-to-point link
WORK_IF=CHANGEME            # worker netdev carrying that IP

# The requant host must also be able to ssh to the other node BY HOSTNAME
# (used to rsync the requantized weights over the fast link).
REQUANT_HOST=$HEAD_HOST     # which node runs the requant (needs the disk)

# ---- paths on the nodes ----
WEIGHTS_ROOT=CHANGEME       # absolute dir on both nodes; >=800 GB free on
                            # the requant host
STOCK_DIR=$WEIGHTS_ROOT/GLM-5.3-Flash-NVFP4      # download target
MODEL_DIR=$WEIGHTS_ROOT/GLM-5.3-Flash-NVFP4-h    # requant output
MTP_DIR=$WEIGHTS_ROOT/GLM-5.3-Flash-MTP-bf16     # BF16 draft; empty = no MTP
REMOTE_DIR=glm53-repo30                          # repo copy on each node
                                                 # (absolute, or relative
                                                 # to the remote $HOME)
REMOTE_DIR_PER_NODE=                             # optional: "node1=<dir>
                                                 # node2=<dir> ..." when the
                                                 # repo dir differs per node;
                                                 # unset = every node is
                                                 # checked under $REMOTE_DIR

# ---- what to fetch ----
MODEL_ID=nvidia/GLM-5.3-Flash-NVFP4
MODEL_REVISION=main         # pin a commit sha to freeze the checkpoint
IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130
NCCL_IB_IMAGE=$IMAGE-nccl-ib

# ---- knobs ----
NCCL_IB=1                   # 1 = RDMA derived image + NET/IB; 0 = sockets
MTP_K=2                     # num_speculative_tokens; do NOT raise (see
                            # AGENTS.md failure modes: K>=4 does not boot)
PORT=8000
VERIFY_TOL=0.07             # verify band: |measured-ref|/ref <= tol;
                            # 0.07 = the measured pair-to-pair offset
                            # (run-to-run noise on one pair is ~4%)

# ---- run bookkeeping ----
LABEL=agent-run             # ruler label; results/measure-$LABEL.json
RESULTS_DIR=results         # local dir the ruler result is pulled back to
