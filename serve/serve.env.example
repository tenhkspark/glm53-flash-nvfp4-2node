# serve.env.example — copy to serve.env, fill in CHANGEME values, then
#   . serve/serve.env
#   ssh <head-node>    'bash serve/start-head.sh'
#   ssh <worker-node>  'bash serve/start-worker.sh'
# (or copy this repo to each node and run the scripts locally).

# ---- node addressing (CHANGEME) ----
export HEAD_IP=CHANGEME        # head node IP on the fast interconnect
export MY_IP=CHANGEME          # this node's IP (worker script only)
export IFNAME=CHANGEME         # netdev carrying RoCE (ibdev2netdev shows it)

# ---- checkpoint (CHANGEME) ----
export MODEL_DIR=CHANGEME      # requantized GLM-5.3-Flash-NVFP4 output dir
# export MTP_DIR=CHANGEME      # BF16 MTP draft dir (enables MTP when set)
export MTP_K=2

# ---- images / overlays ----
export IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130
export NCCL_IB=1                                # 1 = RDMA derived image
export NCCL_IB_IMAGE=${IMAGE}-nccl-ib           # built by Dockerfile.nccl-ib
export OVERLAY_DIR=overlays/_build              # built overlay outputs

export PORT=8000
