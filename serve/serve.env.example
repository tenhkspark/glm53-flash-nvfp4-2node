# serve.env.example — copy to serve.env, fill in CHANGEME values, then
#   . serve/serve.env
#   ssh <head-node>    'bash serve/start-head.sh'
#   ssh <worker-node>  'bash serve/start-worker.sh'
# (or copy this repo to each node and run the scripts locally).
#
# Two things to read before starting: the API has no authentication and
# listens on every interface (see PORT below), and MTP_DIR below is
# commented out, which costs ~20% of the published speed if left that way.

# ---- node addressing (CHANGEME) ----
export HEAD_IP=CHANGEME        # head node IP on the fast interconnect
export MY_IP=CHANGEME          # this node's IP (worker script only)
export IFNAME=CHANGEME         # netdev carrying RoCE (ibdev2netdev shows it)

# ---- checkpoint (CHANGEME) ----
export MODEL_DIR=CHANGEME      # requantized GLM-5.3-Flash-NVFP4 output dir
# ---- MTP draft dir: REQUIRED to reproduce the headline speed ----
# The next line is commented out on purpose (the path differs per machine),
# but a serve started from this file as it ships runs with NO draft and
# decodes at draft-free speed: 28.28 tok/s measured, against 34.99 tok/s with
# the draft on the same configuration -- about 20% off the 35.09 headline.
# So: build the dir with requant/build-mtp-draft.py (AGENTS.md step 2), copy
# it to BOTH nodes, then uncomment the line and put the absolute path in on
# each node. Leave it commented out only if you mean to serve without
# speculation (that is also how the stock gate baseline is taken).
# export MTP_DIR=CHANGEME      # BF16 MTP draft dir (enables MTP when set)
export MTP_K=2

# ---- images / overlays ----
export IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130
export NCCL_IB=1                                # 1 = RDMA derived image
export NCCL_IB_IMAGE=${IMAGE}-nccl-ib           # built by Dockerfile.nccl-ib
# OVERLAY_DIR defaults to <repo>/overlays/_build; set an ABSOLUTE path only
# if you moved the built overlays elsewhere (docker needs an absolute source).
# export OVERLAY_DIR=/abs/path/to/overlays/_build              # built overlay outputs

# The API listens on 0.0.0.0:$PORT with no authentication, so anyone who can
# reach this port can use the server. Trusted network only: put access control
# (firewall / private subnet / ssh tunnel) in front of it, and authentication
# and TLS too if it has to be reachable from further away. Ray is separate --
# the cluster port the worker joins on (HEAD_IP:6399) is not covered by
# anything you put in front of the API. See AGENTS.md section 5.
export PORT=8000

# ---- profiling (off by default) ----
# STEP_ATTR=1 swaps the mla-quant overlay for the instrumented build in
# overlays/_build/step-attr/ and prints per-step attribution to the
# container log. Leave it unset for reproduction runs, and set it on
# BOTH nodes when you do use it.
# export STEP_ATTR=1
# export STEP_ATTR_EVERY=256
